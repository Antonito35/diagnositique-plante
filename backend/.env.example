# Environment Configuration Example
# Copy to .env and fill in actual values

# Application
ENVIRONMENT=development
PORT=8000
DEBUG=True

# Database
DATABASE_URL=postgresql://plantdiag_user:password@localhost:5432/plantdiag
DB_PASSWORD=your_secure_password

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
FRONTEND_URL=http://localhost:3000
MOBILE_URL=http://localhost

# ML Model
MODEL_PATH=./models/mobilenetv2_plantvillage.tflite
MODEL_VERSION=1.0

# Cloud Storage (if using S3/Azure Blob)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_S3_BUCKET=plantdiag-images

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
